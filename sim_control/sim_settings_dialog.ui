}
QTabWidget::pane {
    border: 1px solid #d6deea;
    background: white;
    border-radius: 12px;
    top: -1px;
}
QTabBar::tab {
    background: #e9eef7;
    border: 1px solid #d6deea;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 10px 20px;
    min-width: 110px;
    margin-right: 4px;
    font-size: 15px;
    font-weight: 600;
}
QTabBar::tab:selected {
    background: white;
    border-bottom-color: white;
}
QLabel#dialogHeader {
    font-size: 18px;
    font-weight: 700;
    color: #22314d;
}
QLabel#dialogHint, QLabel#lbl_daq_hint, QLabel#lbl_camera_hint, QLabel#lbl_patterns_hint, QLabel#lbl_laser_hint {
