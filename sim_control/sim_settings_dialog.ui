}
QLineEdit, QComboBox, QPlainTextEdit, QSpinBox {
    border: 1px solid #c8d1e0;
    border-radius: 8px;
    background: white;
    font-size: 14px;
}
QPushButton {
    border: 1px solid #b9c6db;
    border-radius: 10px;
    background: #eef3fb;
    font-size: 14px;
